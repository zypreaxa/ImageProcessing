####### Compile

debug/viewer.o: viewer.cpp qtimageviewer.hpp \
		../imagelib/image.hpp \
		../imagelib/tiffloader.hpp \
		../imagelib/imageloader.hpp
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug/viewer.o viewer.cpp

debug/qtimageviewer.o: qtimageviewer.cpp qtimageviewer.hpp \
		../imagelib/image.hpp \
		../imagelib/tiffloader.hpp \
		../imagelib/imageloader.hpp \
		../imagelib/imageprocessor.hpp
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug/qtimageviewer.o qtimageviewer.cpp

debug/moc_qtimageviewer.o: debug/moc_qtimageviewer.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug/moc_qtimageviewer.o debug/moc_qtimageviewer.cpp

